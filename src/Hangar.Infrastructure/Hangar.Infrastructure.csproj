<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Hangar.Domain\Hangar.Domain.csproj" />
    <ProjectReference Include="..\Hangar.Application\Hangar.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddIdentity<TUser,TRole>() sống trong Microsoft.AspNetCore.Identity.dll, thuộc shared
         framework ASP.NET Core (không phải package NuGet rời) — project này là class library
         thường (Microsoft.NET.Sdk), không tự có reference tới shared framework đó. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Minio" Version="7.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
